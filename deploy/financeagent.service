# 不用 Docker 时的 systemd 服务单元 (裸机部署)
# 安装:
#   sudo cp deploy/financeagent.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now financeagent
# 查看日志: journalctl -u financeagent -f

[Unit]
Description=FinanceAgent 量化回测 Web 控制台
After=network.target

[Service]
Type=simple
# ↓ 改成你的部署路径和用户
WorkingDirectory=/opt/FinanceAgent
User=www-data
ExecStart=/opt/FinanceAgent/.venv/bin/streamlit run app.py \
    --server.port=8501 --server.address=127.0.0.1 \
    --server.headless=true --browser.gatherUsageStats=false
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
